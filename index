<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechNicol Productions LLC | Audio-Visual Engineering &amp; Live Production</title>
  <meta name="description" content="TechNicol Productions LLC offers professional audio/visual engineering, live sound mixing, freelance stagehand labor, RF management, and arena touring technical services across Greater Columbus, Ohio.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #07090e;
      --bg-card: rgba(14, 20, 32, 0.85);
      --bg-card-hover: rgba(22, 32, 50, 0.95);
      --cyan-neon: #00f0ff;
      --cyan-glow: rgba(0, 240, 255, 0.4);
      --amber-neon: #ffb703;
      --amber-glow: rgba(255, 183, 3, 0.4);
      --orange-accent: #ff6b00;
      --orange-glow: rgba(255, 107, 0, 0.45);
      --blue-electric: #0077ff;
      --text-main: #f0f4f8;
      --text-muted: #94a3b8;
      --border-subtle: rgba(0, 240, 255, 0.2);
      --border-bright: rgba(0, 240, 255, 0.6);
      --font-display: 'Orbitron', sans-serif;
      --font-heading: 'Rajdhani', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.6;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(0, 240, 255, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 85% 60%, rgba(255, 107, 0, 0.07) 0%, transparent 45%),
        radial-gradient(circle at 50% 90%, rgba(0, 119, 255, 0.06) 0%, transparent 50%);
      background-attachment: fixed;
    }

    h1, h2, h3, h4, .nav-brand {
      font-family: var(--font-heading);
      letter-spacing: 0.5px;
    }
    
    strong {
      color: #ffffff;
      font-weight: 700;
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.25);
    }

    a {
      color: var(--cyan-neon);
      text-decoration: none;
      transition: all 0.3s ease;
    }

    a:hover {
      text-shadow: 0 0 10px var(--cyan-glow);
      color: #fff;
    }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(7, 9, 14, 0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.6);
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      max-width: 1300px;
      margin: 0 auto;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .nav-logo-video {
      width: 56px;
      height: 56px;
      border-radius: 10px;
      border: 1px solid var(--cyan-neon);
      box-shadow: 0 0 15px var(--cyan-glow);
      object-fit: cover;
    }

    .nav-brand {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 700;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      background: linear-gradient(135deg, #ffffff 0%, var(--cyan-neon) 60%, var(--amber-neon) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 24px;
      align-items: center;
    }

    .nav-links a {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 6px 12px;
      border-radius: 6px;
      transition: all 0.3s ease;
    }

    .nav-links a:hover, .nav-links a.active {
      color: var(--cyan-neon);
      background: rgba(0, 240, 255, 0.08);
      box-shadow: 0 0 12px var(--cyan-glow);
    }

    .nav-cta {
      border: 1px solid var(--amber-neon) !important;
      color: var(--amber-neon) !important;
      background: rgba(255, 183, 3, 0.08) !important;
    }

    .nav-cta:hover {
      background: var(--amber-neon) !important;
      color: #000000 !important;
      box-shadow: 0 0 20px var(--amber-glow) !important;
    }

    .hero {
      position: relative;
      padding: 70px 0 50px;
      text-align: center;
      overflow: hidden;
    }

    .hero-video-box {
      max-width: 460px;
      margin: 0 auto 30px;
      position: relative;
      border-radius: 16px;
      padding: 4px;
      background: linear-gradient(135deg, var(--cyan-neon), transparent 40%, var(--amber-neon));
      box-shadow: 0 0 35px var(--cyan-glow);
    }

    .hero-video {
      width: 100%;
      height: auto;
      border-radius: 12px;
      display: block;
      background: #000;
    }

    .badge-orange {
      display: inline-block;
      background: linear-gradient(90deg, rgba(255, 107, 0, 0.25), rgba(255, 183, 3, 0.25));
      border: 1px solid var(--orange-accent);
      color: #ff9e42;
      padding: 8px 24px;
      border-radius: 50px;
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      margin-bottom: 24px;
      box-shadow: 0 0 20px var(--orange-glow);
      text-transform: uppercase;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: 2.6rem;
      line-height: 1.2;
      margin-bottom: 20px;
      background: linear-gradient(180deg, #ffffff 30%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 25px rgba(255, 255, 255, 0.15);
    }

    .hero-subtitle {
      font-size: 1.25rem;
      max-width: 860px;
      margin: 0 auto 36px;
      color: #94a3b8;
    }

    .hero-highlights {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
      margin-bottom: 45px;
    }

    .hero-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      padding: 10px 20px;
      border-radius: 30px;
      font-family: var(--font-heading);
      font-size: 1.05rem;
      font-weight: 600;
      color: #e2e8f0;
      transition: all 0.3s;
    }

    .hero-pill:hover {
      border-color: var(--cyan-neon);
      box-shadow: 0 0 15px var(--cyan-glow);
      transform: translateY(-2px);
    }

    .feature-boxes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 28px;
      text-align: left;
      position: relative;
      overflow: hidden;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan-neon), var(--amber-neon));
      opacity: 0.7;
    }

    .feature-card:hover {
      background: var(--bg-card-hover);
      border-color: var(--cyan-neon);
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 240, 255, 0.2);
    }

    .feature-card h3 {
      font-size: 1.35rem;
      margin-bottom: 12px;
      color: #ffffff;
    }

    .feature-card p {
      color: var(--text-muted);
      font-size: 0.98rem;
    }

    section {
      padding: 75px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: 2.1rem;
      text-transform: uppercase;
      margin-bottom: 14px;
      position: relative;
      display: inline-block;
    }

    .section-title::after {
      content: '';
      display: block;
      width: 60px;
      height: 3px;
      background: var(--cyan-neon);
      box-shadow: 0 0 10px var(--cyan-glow);
      margin-top: 8px;
    }

    .section-desc {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 850px;
      margin-bottom: 36px;
    }

    .capabilities-box {
      background: linear-gradient(135deg, rgba(14, 20, 32, 0.95), rgba(20, 30, 48, 0.85));
      border: 1px solid var(--border-bright);
      border-radius: 16px;
      padding: 36px;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.15);
    }

    .capabilities-lead {
      font-size: 1.2rem;
      line-height: 1.8;
      color: #f1f5f9;
      margin-bottom: 24px;
    }

    .capabilities-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .cap-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 18px 20px;
      transition: all 0.3s;
    }

    .cap-item:hover {
      border-color: var(--amber-neon);
      box-shadow: 0 0 15px var(--amber-glow);
      background: rgba(255, 183, 3, 0.05);
    }

    .cap-item h4 {
      font-size: 1.15rem;
      color: var(--amber-neon);
      margin-bottom: 6px;
    }

    .cap-item p {
      font-size: 0.92rem;
      color: var(--text-muted);
    }

    .career-section-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 34px;
      margin-bottom: 36px;
      position: relative;
      transition: all 0.3s;
    }

    .career-section-card:hover {
      border-color: var(--cyan-neon);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
    }

    .career-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 14px;
      margin-bottom: 18px;
      gap: 12px;
    }

    .career-header h3 {
      font-size: 1.55rem;
      color: #ffffff;
    }

    .career-header .timeline {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      color: var(--amber-neon);
      font-weight: 600;
    }

    .career-role {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--cyan-neon);
      margin-bottom: 16px;
    }

    .career-details ul {
      list-style-type: none;
      margin-bottom: 26px;
    }

    .career-details li {
      position: relative;
      padding-left: 24px;
      margin-bottom: 12px;
      color: #cbd5e1;
    }

    .career-details li::before {
      content: '▹';
      position: absolute;
      left: 0;
      color: var(--cyan-neon);
      font-size: 1.2rem;
      line-height: 1.4;
    }

    .popup-buttons-title {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: 700;
      color: #e2e8f0;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .popup-buttons-title span {
      color: var(--cyan-neon);
    }

    .popup-btn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 12px;
    }

    .popup-btn {
      background: rgba(10, 15, 26, 0.9);
      border: 1px solid rgba(0, 240, 255, 0.3);
      color: #e2e8f0;
      padding: 10px 14px;
      border-radius: 8px;
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      transition: all 0.25s ease;
    }

    .popup-btn:hover {
      background: rgba(0, 240, 255, 0.15);
      border-color: var(--cyan-neon);
      color: #ffffff;
      box-shadow: 0 0 15px var(--cyan-glow);
      transform: translateY(-2px);
    }

    .popup-btn .btn-num {
      font-size: 0.8rem;
      color: var(--amber-neon);
      font-family: var(--font-display);
    }

    .field-notes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .field-note-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 26px;
      transition: all 0.3s;
    }

    .field-note-card:hover {
      border-color: var(--amber-neon);
      box-shadow: 0 0 20px var(--amber-glow);
      transform: translateY(-4px);
    }

    .field-note-card h4 {
      font-size: 1.25rem;
      color: var(--amber-neon);
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(255, 183, 3, 0.2);
      padding-bottom: 8px;
    }

    .field-note-card p, .field-note-card li {
      font-size: 0.95rem;
      color: #cbd5e1;
      margin-bottom: 10px;
    }

    .field-note-card ul {
      list-style-type: none;
      padding-left: 0;
    }

    .field-note-card li {
      position: relative;
      padding-left: 18px;
    }

    .field-note-card li::before {
      content: '▪';
      position: absolute;
      left: 0;
      color: var(--amber-neon);
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .portfolio-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 24px;
      min-height: 380px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portfolio-card:hover {
      border-color: var(--cyan-neon);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.3);
      transform: translateY(-4px);
    }

    .card-main-content {
      transition: opacity 0.3s ease;
    }

    .portfolio-card .tile-num {
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: var(--cyan-neon);
      margin-bottom: 8px;
    }

    .portfolio-card h3 {
      font-size: 1.35rem;
      color: #ffffff;
      margin-bottom: 12px;
    }

    .portfolio-card p {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .card-footer-prompt {
      margin-top: 16px;
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--amber-neon);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .quadrant-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 4px;
      background: rgba(7, 9, 14, 0.96);
      padding: 10px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 10;
    }

    .portfolio-card:hover .quadrant-grid {
      opacity: 1;
      pointer-events: auto;
    }

    .quadrant-item {
      background: rgba(14, 22, 38, 0.9);
      border: 1px solid rgba(0, 240, 255, 0.25);
      border-radius: 8px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transition: all 0.2s;
    }

    .quadrant-item:hover {
      background: rgba(0, 240, 255, 0.2);
      border-color: var(--cyan-neon);
      box-shadow: 0 0 12px var(--cyan-glow);
      transform: scale(1.02);
    }

    .quad-tag {
      font-family: var(--font-display);
      font-size: 0.8rem;
      color: var(--amber-neon);
      margin-bottom: 4px;
    }

    .quad-title {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
    }

    .booking-wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 40px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 38px;
    }

    .booking-info h3 {
      font-size: 1.75rem;
      color: #ffffff;
      margin-bottom: 16px;
    }

    .contact-item {
      margin-bottom: 18px;
    }

    .contact-item label {
      display: block;
      font-family: var(--font-heading);
      font-size: 0.95rem;
      color: var(--amber-neon);
      text-transform: uppercase;
    }

    .contact-item .val {
      font-size: 1.15rem;
      color: #ffffff;
      font-weight: 600;
    }

    .booking-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      color: #cbd5e1;
    }

    .form-control {
      background: rgba(7, 9, 14, 0.8);
      border: 1px solid rgba(0, 240, 255, 0.3);
      color: #ffffff;
      padding: 12px 16px;
      border-radius: 8px;
      font-family: var(--font-body);
      font-size: 1rem;
      transition: all 0.3s;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--cyan-neon);
      box-shadow: 0 0 15px var(--cyan-glow);
    }

    .btn-submit {
      background: linear-gradient(90deg, var(--cyan-neon), var(--blue-electric));
      color: #000000;
      border: none;
      padding: 14px 24px;
      border-radius: 8px;
      font-family: var(--font-heading);
      font-size: 1.2rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.3s;
      margin-top: 8px;
    }

    .btn-submit:hover {
      box-shadow: 0 0 25px var(--cyan-glow);
      transform: translateY(-2px);
      color: #ffffff;
    }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      z-index: 2000;
      display: none;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-content {
      background: #0d1322;
      border: 1px solid var(--cyan-neon);
      box-shadow: 0 0 35px var(--cyan-glow);
      border-radius: 16px;
      max-width: 800px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 36px;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      background: none;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 1.5rem;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .modal-close:hover {
      border-color: var(--orange-accent);
      color: var(--orange-accent);
      box-shadow: 0 0 10px var(--orange-glow);
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .modal-subtitle {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      color: var(--cyan-neon);
      margin-bottom: 22px;
    }

    .modal-body {
      color: #cbd5e1;
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .modal-media-placeholder {
      background: rgba(0, 0, 0, 0.5);
      border: 1px dashed var(--border-subtle);
      border-radius: 10px;
      padding: 35px 20px;
      text-align: center;
      margin: 20px 0;
      color: var(--text-muted);
    }

    footer {
      background: #05070a;
      border-top: 1px solid var(--border-subtle);
      padding: 40px 0 30px;
      text-align: center;
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .footer-links {
      display: flex;
      gap: 20px;
      list-style: none;
      margin-bottom: 10px;
    }

    .footer-links a {
      color: var(--text-muted);
      font-family: var(--font-heading);
      font-size: 1rem;
    }

    .footer-links a:hover {
      color: var(--cyan-neon);
    }

    .footer-copy {
      font-size: 0.9rem;
      color: #64748b;
    }

    @media (max-width: 768px) {
      .nav-container {
        flex-direction: column;
        gap: 12px;
      }
      .nav-links {
        flex-wrap: wrap;
